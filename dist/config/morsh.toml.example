# morsh Client Configuration File Template
# Copy to ~/.morsh/config.toml or reference via morsh -F /path/to/config.toml

# --- Global Default Options ---
# Default port if omitted in destination (defaults to 2222)
# port = 2222

# Default remote login username
# user = "alice"

# Default private key file
# identity_file = "~/.ssh/id_ed25519"

# Stealth knock path prefix (SSH3 style anti-scanning defense)
# stealth_knock = "/stealth-secret-knock"

# Force TLS 1.3 over TCP fallback (bypasses UDP/QUIC)
# force_tcp = false

# Happy Eyeballs fallback threshold timer in milliseconds
# tcp_fallback_timeout = 300

# Predictive local echo mode: "auto", "always", or "never"
# predict_mode = "auto"

# Predictive echo visual style: "underline", "dim", or "none"
# predict_style = "underline"

# Query local ssh-agent ($SSH_AUTH_SOCK)
# forward_agent = true

# Accept unverified / self-signed server certificates (testing only)
# insecure = false

# Request stream compression
# compress = false

# Default port forwardings:
# local_forward = ["8080:127.0.0.1:80"]
# remote_forward = ["9090:127.0.0.1:3000"]
# dynamic_forward = ["1080"]
# udp_forward = ["5353:1.1.1.1:53"]

# --- Host-Specific Matching Rules ---
# Host rules support wildcards ('*', '?'), space-separated patterns, and negations ('!')

[[host]]
pattern = "*.corp.internal"
user = "alice"
port = 4433
stealth_knock = "/corp-gateway"
force_tcp = true

[[host]]
pattern = "prod-*"
user = "deploy"
port = 2222
identity_file = "~/.ssh/prod_ed25519"
predict_mode = "always"
predict_style = "underline"

[[host]]
pattern = "bastion"
host_name = "192.168.1.100"
port = 2222
user = "admin"
identity_file = "~/.ssh/bastion_key"

[[host]]
pattern = "!bad.corp *.corp"
port = 2222
forward_agent = true
